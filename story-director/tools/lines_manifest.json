[
 {
  "id": "L000",
  "actor": "feng",
  "text": "你们好呀！我叫阿风，第一次走这条商道，差点在草海里迷路。"
 },
 {
  "id": "L001",
  "actor": "xue",
  "text": "欢迎，阿风。我叫雪，受商会之托，要前往北方的望风塔。"
 },
 {
  "id": "L002",
  "actor": "ye",
  "text": "护卫，夜。前面的路不太平，人多有个照应。"
 },
 {
  "id": "L003",
  "actor": "feng",
  "text": "诶？夜先生看起来好严肃，是不是不爱说话呀？"
 },
 {
  "id": "L004",
  "actor": "ye",
  "text": "……话不多，但算数。"
 },
 {
  "id": "L005",
  "actor": "feng",
  "text": "那就说定了，一起走吧！目的地，望风塔！"
 },
 {
  "id": "L006",
  "actor": "xue",
  "text": "说起来，阿风为什么一个人旅行？家里不担心吗？"
 },
 {
  "id": "L007",
  "actor": "feng",
  "text": "因为我想写一本《帕米尔见闻录》！把大陆每个角落都走一遍！"
 },
 {
  "id": "L008",
  "actor": "ye",
  "text": "……志向不小。前面那段路，前几日刚有商队遇袭。"
 },
 {
  "id": "L009",
  "actor": "xue",
  "text": "所以，还是跟夜先生搭伴比较稳妥。"
 },
 {
  "id": "L010",
  "actor": "feng",
  "text": "你们听！风铃的声音！老话说是旅人的守护灵在打招呼！"
 },
 {
  "id": "L011",
  "actor": "xue",
  "text": "但愿这位守护灵，也能保佑我们的货物。"
 },
 {
  "id": "L012",
  "actor": "ye",
  "text": "守护灵不管强盗。管强盗的是我。"
 },
 {
  "id": "L013",
  "actor": "feng",
  "text": "噗——夜先生偶尔说话，还挺好笑的。"
 },
 {
  "id": "L014",
  "actor": "ye",
  "text": "翻过前面那道坡，就是旧王国的地界。"
 },
 {
  "id": "L015",
  "actor": "feng",
  "text": "旧王国……见闻录里写过！一千年前的商路，就是从那里开始的！"
 },
 {
  "id": "L016",
  "actor": "xue",
  "text": "看，废墟到了。今晚就在那里过夜。"
 },
 {
  "id": "L017",
  "actor": "ye",
  "text": "就在这里扎营。石墙背风，天黑前把火生起来。"
 },
 {
  "id": "L018",
  "actor": "xue",
  "text": "趁着天还没黑……要不要跳支舞？小时候跟商队的艺人学过。"
 },
 {
  "id": "L019",
  "actor": "feng",
  "text": "雪你也太厉害了吧！转圈的时候裙摆都发光了！"
 },
 {
  "id": "L020",
  "actor": "xue",
  "text": "哈哈，都是很久之前的事啦，手法都生疏了。"
 },
 {
  "id": "L021",
  "actor": "ye",
  "text": "（鼓掌）很少见到这么轻快的舞步。"
 },
 {
  "id": "L022",
  "actor": "feng",
  "text": "看好了，接下来是阿风的绝活！肌肉才是浪漫！"
 },
 {
  "id": "L023",
  "actor": "xue",
  "text": "噗——阿风，你这算哪门子舞蹈呀。"
 },
 {
  "id": "L024",
  "actor": "ye",
  "text": "……那么，看好了。护卫的舞，只有一套。"
 },
 {
  "id": "L025",
  "actor": "feng",
  "text": "哇——夜先生深藏不露啊！！"
 },
 {
  "id": "L026",
  "actor": "ye",
  "text": "雪小姐是商会的人，为什么会亲自跑这么远的路？"
 },
 {
  "id": "L027",
  "actor": "xue",
  "text": "这批货里，有一封要紧的信。要亲手交给望风塔的塔主。"
 },
 {
  "id": "L028",
  "actor": "xue",
  "text": "信里写了什么，我也不知道。只知道，很多人都在等着它。"
 },
 {
  "id": "L029",
  "actor": "feng",
  "text": "神秘！我最喜欢神秘的东西了！写书的时候一定用它当开头！"
 },
 {
  "id": "L030",
  "actor": "ye",
  "text": "……你的『最喜欢』，多半会让我们绕远路。"
 },
 {
  "id": "L031",
  "actor": "feng",
  "text": "哎呀，上次绕远路那只是意外啦！"
 },
 {
  "id": "L032",
  "actor": "xue",
  "text": "我的家乡在海边。出发前，母亲替我缝了这件衣服的领口。"
 },
 {
  "id": "L033",
  "actor": "xue",
  "text": "她说，路上的风大。其实我知道，她是舍不得。"
 },
 {
  "id": "L034",
  "actor": "ye",
  "text": "都睡吧。前半夜我来守。"
 },
 {
  "id": "L035",
  "actor": "xue",
  "text": "夜先生……谢了。对了，你为什么做护卫这一行？"
 },
 {
  "id": "L036",
  "actor": "ye",
  "text": "走过的地方多了，就会发现——有人等着你回去，是一件奢侈的事。"
 },
 {
  "id": "L037",
  "actor": "ye",
  "text": "护卫这行，护的其实不是货。是『归途』。"
 },
 {
  "id": "L038",
  "actor": "xue",
  "text": "等这趟货送完……我想回家看看。"
 },
 {
  "id": "L039",
  "actor": "ye",
  "text": "嗯。到时候，顺路。"
 },
 {
  "id": "L040",
  "actor": "feng",
  "text": "唔啊——睡得真好！今天就能到望风塔了吧！"
 },
 {
  "id": "L041",
  "actor": "ye",
  "text": "收拾一下，出发。趁露水没干，路好走。"
 },
 {
  "id": "L042",
  "actor": "xue",
  "text": "这一路，多谢两位照顾。信送到之后，我想请你们喝一杯热茶。"
 },
 {
  "id": "L043",
  "actor": "feng",
  "text": "热茶就算了，要喝就喝庆功酒！"
 },
 {
  "id": "L044",
  "actor": "ye",
  "text": "……庆功酒，可以。"
 }
]